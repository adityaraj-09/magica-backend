# Local / IPv6: direct host :5432.
# Render is IPv4-only. Prefer the Supabase *session* pooler (:5432 on
# aws-*.pooler.supabase.com) for the app — Prisma interactive transactions
# (send, credit reserve) break on the transaction pooler (:6543) with P2028.
# Use :6543 only if you must, with ?pgbouncer=true&sslmode=require&connection_limit=1.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/galaxy"
# Session pooler or direct URL for `prisma migrate deploy`.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/galaxy"

# Required Magica (server-only — never send to the client or the model)
MAGICA_API_KEY=
MAGICA_BASE_URL="https://inference.magica.com"
MAGICA_POLL_INTERVAL_MS="2000"
MAGICA_POLL_TIMEOUT_MS="480000"

# Required E2B sandbox
E2B_API_KEY=

# Optional web search. If EXA_API_KEY is empty, the stub adapter is used.
WEB_SEARCH_PROVIDER="exa"
EXA_API_KEY=
EXA_BASE_URL="https://api.exa.ai"

# Application-owned skills (comma-separated approved directories)
SKILLS_DIR="agent-skills"

OPENROUTER_API_KEY=
# Must be openrouter/free. Any other value is rejected; there is no paid fallback.
OPENROUTER_MODEL="openrouter/free"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_TIMEOUT_MS="120000"

# Clerk (server secret never goes to the client)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Required. Application credits granted once on first authenticated request.
# No code default — set this explicitly (e.g. 100).
CREDIT_GRANT_INITIAL=

# Trigger.dev (orchestrator + Magica/E2B/Exa child tasks)
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# Required. Credits reserved at send (debited from the ledger as RESERVE).
# Settled later against actual tool costs. No code default.
CREDIT_RESERVE_TURN=

# Transloadit Community (server-only — never send the secret to the client)
TRANSLOADIT_KEY=
TRANSLOADIT_SECRET=
# Optional pingback for Assembly completion. Frontend complete is the fallback.
TRANSLOADIT_NOTIFY_URL=

# Agent loop
AGENT_MAX_TURNS="8"
WAITPOINT_TIMEOUT="24h"

# Send-route rate limit (counted as AgentRuns created in the window).
SEND_RATE_LIMIT_PER_MINUTE="20"
SEND_RATE_WINDOW_SECONDS="60"

# Durable object storage for Magica/E2B result URLs (R2-compatible S3).
# If any of these are empty, generated assets keep the ephemeral provider URL.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION="auto"
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE="true"
