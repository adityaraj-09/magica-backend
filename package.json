{
  "name": "galaxy-agent-backend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:constraints": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f prisma/sql/0001_constraints.sql",
    "postinstall": "prisma generate",
    "trigger:dev": "npx trigger.dev@latest dev",
    "trigger:deploy": "npx trigger.dev@latest deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@clerk/nextjs": "^7.9.4",
    "@e2b/code-interpreter": "^2.8.0",
    "@prisma/client": "^6.19.3",
    "@trigger.dev/sdk": "^4.6.3",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@trigger.dev/build": "^4.6.3",
    "@types/node": "^22.13.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "6.19.3",
    "typescript": "^5.8.2",
    "vitest": "^5.0.1"
  }
}
